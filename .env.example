# === OBRIGATÓRIO ===
TELEGRAM_TOKEN=seu_token_aqui
SUPABASE_URL=https://seuprojeto.supabase.co
SUPABASE_KEY=sua_chave_aqui

# === GERAÇÃO DE IMAGEM/VIDEO ===
# Pelo menos um dos dois precisa estar configurado
REPLICATE_API_KEY=sua_key_replicate  # Fallback (ganha $5 grátis)

# RunPod (principal, mais barato) - configurar depois
RUNPOD_API_KEY=sua_key_runpod
RUNPOD_ENDPOINT_ID=id_do_endpoint

# === PAGAMENTO ===
MERCADOPAGO_ACCESS_TOKEN=seu_access_token
MERCADOPAGO_WEBHOOK_SECRET=seu_webhook_secret

# === OPCIONAL ===
BOT_WEBHOOK_URL=https://seubot.railway.app/webhook
DATABASE_URL=postgresql://...
